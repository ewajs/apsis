{
  "name": "apsis",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Deep-space missions in a 3D solar system, from JPL Horizons data.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run build && playwright test",
    "icons": "node scripts/icons.ts",
    "data": "node scripts/data/fetch.ts",
    "data:orbits": "node scripts/data/orbits.ts",
    "data:archive": "node scripts/data/archive.ts",
    "models": "node scripts/models/models.ts",
    "models:ar": "node scripts/models/models-ar.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "draco3dgltf": "^1.5.9",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.1",
    "meshoptimizer": "^1.3.0",
    "prettier": "3.10.1",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lit/localize": "0.12.2",
    "lit": "3.3.3",
    "three": "0.187.0"
  }
}
